# Copy this file to `.env` in the project root and fill in real values.
# `.env` is gitignored — never commit real secrets.

# ─── App ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=KnowSphere AI
SECRET_KEY=replace-with-a-long-random-string
LOG_LEVEL=INFO

# ─── Database ──────────────────────────────────────────────────────────
# Used directly by the backend when running outside Docker (falls back to
# a local SQLite file if unset — but only for Phase 1's tables; Phase 2's
# documents/document_chunks tables require a real PostgreSQL instance with
# the pgvector extension enabled). When running via docker-compose, the
# backend service's DATABASE_URL is set automatically to point at the
# `postgres` container instead — see docker-compose.yml.
DATABASE_URL=postgresql://knowsphere:knowsphere@localhost:5432/knowsphere_ai
POSTGRES_USER=knowsphere
POSTGRES_PASSWORD=knowsphere
POSTGRES_DB=knowsphere_ai

# ─── JWT ───────────────────────────────────────────────────────────────
JWT_SECRET_KEY=replace-with-a-different-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ─── Encryption (provider API keys + LangSmith key at rest) ───────────
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ─── Logging (Phase 6) ──────────────────────────────────────────────────
# "text" is human-readable (what every terminal output in this project's
# own development looked like); "json" is structured, one object per
# line, for log aggregators (CloudWatch/Datadog/Loki). Use json in
# production.
LOG_FORMAT=text

# ─── Malware scanning (Phase 6, optional) ──────────────────────────────
# If unset, file uploads skip real malware scanning and the security
# service honestly reports "not_configured" rather than a fake "clean"
# result (see app/security/file_validation.py). Set both to enable real
# scanning against a running ClamAV daemon (clamd).
CLAMD_HOST=
CLAMD_PORT=3310

# ─── Redis / Celery (Phase 2+) ─────────────────────────────────────────
# Docker Compose sets this automatically to point at the `redis` service.
REDIS_URL=redis://localhost:6379/0

# ─── File uploads (Phase 2+) ────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ─── Frontend ──────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api/v1
