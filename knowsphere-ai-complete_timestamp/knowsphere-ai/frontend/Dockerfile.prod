# Multi-stage production Dockerfile (Phase 6 Docker optimization).
#
# Builder stage runs the real Vite production build (the same one verified
# throughout Phase 1-5 development); the final stage is just nginx serving
# the static output — no Node.js, no npm, no source code in the final
# image at all. This is a genuinely different, much smaller image than the
# dev Dockerfile (node:20-slim running a live dev server), not just a
# renamed copy of it.
#
# Build-time note: Vite bakes VITE_API_BASE_URL into the JS bundle at BUILD
# time, not runtime (see vite.config.ts / import.meta.env usage throughout
# src/api/*.ts) — pass it as a build arg if your backend isn't at the
# default http://localhost:5000/api/v1:
#   docker build --build-arg VITE_API_BASE_URL=https://api.example.com/api/v1 -f Dockerfile.prod .

# ---------- Builder ----------
FROM node:20-slim AS builder

WORKDIR /app

COPY package.json ./
RUN npm install

COPY . .

ARG VITE_API_BASE_URL=http://localhost:5000/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

# ---------- Final ----------
FROM nginx:1.27-alpine AS final

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://localhost:80/ || exit 1
